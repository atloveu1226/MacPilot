# Qwen / DashScope OpenAI-compatible API.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
# Workspace Key（sk-ws-...）需要填写对应的 Workspace ID 和地域。
QWEN_WORKSPACE_ID=
QWEN_REGION=cn-beijing
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Keep the first demo scoped to this directory.
MACPILOT_WORKSPACE=./data/workspace
MACPILOT_MAX_FILE_BYTES=200000
MACPILOT_AGENT_TIMEOUT_SECONDS=120
MACPILOT_DB_PATH=./data/macpilot.sqlite3
MACPILOT_READ_ONLY=true
# Empty means browser access is denied. Use comma-separated domains only.
MACPILOT_ALLOWED_BROWSER_DOMAINS=
MACPILOT_CONTEXT_MAX_TOKENS=12000
MACPILOT_CACHE_ENABLED=true
MACPILOT_CACHE_TTL_SECONDS=86400
# Optional pricing, in USD per million tokens, for local cost estimates.
