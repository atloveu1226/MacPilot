{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacPilot",
  "version": "0.1.0",
  "identifier": "com.macpilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MacPilot",
        "width": 920,
        "height": 760,
        "minWidth": 460,
        "minHeight": 560,
        "resizable": true,
        "decorations": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray.svg",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/tray.svg"]
  }
}
